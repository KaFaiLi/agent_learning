AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

AGENT_WORKSPACE=.
AGENT_AGENT_DIR=./demo_agents
AGENT_SKILL_DIR=./demo_skills
AGENT_MCP_CONFIG=./mcp_servers.yaml
AGENT_SETTINGS=./settings.json
AGENT_DEFAULT_AGENT=goal-runner
AGENT_DEFAULT_GOAL=Inspect the workspace and propose a useful next step.
AGENT_MAX_ITERATIONS=12
AGENT_STEP_BUDGET_USD=0.5
AGENT_RUN_BUDGET_USD=5.0
AGENT_INPUT_PRICE_PER_1K=0.0
AGENT_OUTPUT_PRICE_PER_1K=0.0
